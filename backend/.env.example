# Celo Sepolia
RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CHAIN_ID=11142220
CONTRACT_ADDRESS=0x3Ed7b04b5B0dE9CaD355A229FE503C9e5711CdE0
# Issuer signs the EIP-712 vouchers; relayer pays gas (student stays gas-free).
# In this demo both are the deployer/owner key.
ISSUER_PRIVATE_KEY=0xYOUR_ISSUER_KEY
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_KEY
# Optional: enables the event indexer + credential listing API
DATABASE_URL=postgres://user:pass@localhost:5432/credentials
PORT=8130
